# Bu faylni nusxa qilib ".env" deb nomlang va qiymatlarni to'ldiring.
# .env faylini hech kimga yubormang va GitHub'ga yuklamang.
TELEGRAM_BOT_TOKEN=bu_yerga_BotFather_bergan_token
ANTHROPIC_API_KEY=bu_yerga_sk-ant-_bilan_boshlanadigan_kalit
# Sizning Telegram ID raqamingiz (bo'sh qoldirsangiz, bot sizga ID'ingizni aytadi)
ALLOWED_USER_IDS=
# Ixtiyoriy: model nomi
CLAUDE_MODEL=claude-sonnet-5-5
# Ixtiyoriy: ovozli xabarlar uchun (console.groq.com -> API Keys)
GROQ_API_KEY=
